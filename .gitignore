# Python build / test artifacts, incl. those produced by the
# `pip install -e ".[dev]"` + `pytest tests/` flow in README.md.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.DS_Store

# Agent/runtime state. Duplicated in the vibe-managed block below so
# these stay excluded if that block is ever removed per its own opt-out.
.claude/settings.local.json
.vibe/
.vibe-signals/

# >>> vibe-managed runtime exclusions (auto-added; do not edit body) >>>
# Files vibe writes to /workspace at runtime. Committing them
# leaks per-machine state into the repo (PR-review-noise risk).
# Opt out: set VIBE_AUTO_GITIGNORE=0 before container start, or
# delete this entire block (won't be re-added once removed).
.claude/settings.local.json
.vibe/
.vibe-signals/
# <<< vibe-managed <<<
